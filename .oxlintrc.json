{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "no-ternary": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "id-length": "off",
    "unicorn/prefer-global-this": "off"
  },
  "ignorePatterns": ["dist"]
}
